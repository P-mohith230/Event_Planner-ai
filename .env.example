# EventPilot Environment Variables
# Copy this file to .env.local for local development.
# IMPORTANT: Never commit .env.local or your actual API keys to version control.

# Google Gemini API Key (Server-Side Only)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Selection (Defaults to gemini-2.5-flash or gemini-1.5-flash if unset)
GEMINI_MODEL=gemini-2.5-flash
